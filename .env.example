# Client-exposed Firebase config (NEXT_PUBLIC_ prefix = bundled into the
# browser build, not secret). Required — the app can't authenticate or
# read/write Firestore without these; there's no fallback for a missing
# Firebase config, by design (see lib/firebase.ts).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin service account (never NEXT_PUBLIC_ — this
# grants full read/write, unlike the client keys above). Required for
# every app/api/** route. Lazily initialized (lib/firebaseAdmin.ts), so a
# missing value here fails at request time with a clear error, not at
# `next build` — a clean CI checkout with none of these set can still
# build successfully.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Vercel stores newlines in this value as literal "\n" — lib/firebaseAdmin.ts
# already un-escapes that, so paste the key exactly as Firebase gave it to you.
FIREBASE_ADMIN_PRIVATE_KEY=

# Required for the invite-partner email to link back to the right domain,
# and for the Web Share / WhatsApp fallback on the setup confirmation
# screen. Not strictly required for `next build` to succeed, but its
# absence isn't caught anywhere either — an unset value silently produces
# a broken "undefined/invite/xxx" URL in real invite emails rather than an
# error, so treat this as required in every real environment.
NEXT_PUBLIC_APP_URL=

# Resend (transactional email) — invite emails, weekly proposal/confirm
# notifications when push isn't available. Optional in the sense that a
# missing key doesn't crash anything (lib/notify.ts's fetch call just
# fails and is logged/treated as a failed delivery, same as any other
# Resend outage), but real invites and notifications won't be delivered
# without it.
RESEND_API_KEY=

# Shared secret checked by app/api/weekly-propose/route.ts so the daily
# cron endpoint can't be triggered by anyone who finds the URL. Optional
# for local dev (an unset value just means no request's Authorization
# header will ever match "Bearer undefined", so the route safely 401s
# instead of crashing) — required wherever the real Vercel Cron job runs.
CRON_SECRET=

# Tier-1 (primary) of the venue-recommendation pipeline in
# app/api/weekly-propose/route.ts — the decoupled Python/FastAPI RAG
# service (see /rag-service). Optional: if unset, tryRagService() returns
# null immediately and the pipeline falls through to the Firestore tier,
# then the static catalog — the whole point of that 3-tier design is that
# this being unset is a normal, fully-supported state, not an error.
RAG_SERVICE_URL=

# Fal.ai — powers the AI venue mood illustrations for discovery-grid tiles
# with no real photo (app/api/ai-venue-mood/route.ts). Optional: if unset,
# the route returns 501 immediately and the tile falls back to its plain
# tinted block, exactly as it behaved before this feature existed. No key
# is currently configured in this project as of when this file was written.
FAL_API_KEY=

# NOT USED IN THIS APP — GROQ_API_KEY was previously called inline from
# weekly-propose/route.ts; that LLM call now lives inside the separate
# /rag-service Python service instead (see its own README/.env), so this
# app has no code path that reads it anymore. Left out of the list above
# rather than kept as a stale, misleading entry.
