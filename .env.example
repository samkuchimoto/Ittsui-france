# Client-exposed Firebase config (NEXT_PUBLIC_ prefix = bundled into the
# browser build, not secret). Required — the app can't authenticate or
# read/write Firestore without these; there's no fallback for a missing
# Firebase config, by design (see lib/firebase.ts).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin service account (never NEXT_PUBLIC_ — this
# grants full read/write, unlike the client keys above). Required for
# every app/api/** route. Lazily initialized (lib/firebaseAdmin.ts), so a
# missing value here fails at request time with a clear error, not at
# `next build` — a clean CI checkout with none of these set can still
# build successfully.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Vercel stores newlines in this value as literal "\n" — lib/firebaseAdmin.ts
# already un-escapes that, so paste the key exactly as Firebase gave it to you.
FIREBASE_ADMIN_PRIVATE_KEY=

# Required for the invite-partner email to link back to the right domain,
# and for the Web Share / WhatsApp fallback on the setup confirmation
# screen. Not strictly required for `next build` to succeed, but its
# absence isn't caught anywhere either — an unset value silently produces
# a broken "undefined/invite/xxx" URL in real invite emails rather than an
# error, so treat this as required in every real environment.
NEXT_PUBLIC_APP_URL=

# Resend (transactional email) — invite emails, weekly proposal/confirm
# notifications when push isn't available. Optional in the sense that a
# missing key doesn't crash anything (lib/notify.ts's fetch call just
# fails and is logged/treated as a failed delivery, same as any other
# Resend outage), but real invites and notifications won't be delivered
# without it.
RESEND_API_KEY=

# Shared secret checked by app/api/weekly-propose/route.ts so the daily
# cron endpoint can't be triggered by anyone who finds the URL. Optional
# for local dev (an unset value just means no request's Authorization
# header will ever match "Bearer undefined", so the route safely 401s
# instead of crashing) — required wherever the real Vercel Cron job runs.
CRON_SECRET=

# Tier-1 (primary) of the venue-recommendation pipeline in
# app/api/weekly-propose/route.ts — the decoupled Python/FastAPI RAG
# service (see /rag-service). Optional: if unset, tryRagService() returns
# null immediately and the pipeline falls through to the Firestore tier,
# then the static catalog — the whole point of that 3-tier design is that
# this being unset is a normal, fully-supported state, not an error.
RAG_SERVICE_URL=

# Fal.ai — powers the AI venue mood illustrations for discovery-grid tiles
# with no real photo (app/api/ai-venue-mood/route.ts), AND (as of
# 2026-08-27) "Ittsui Painting", the real AI-generated-illustration mode
# of "envoyer un geste" (app/api/gestures/route.ts's generatePainting()).
# Optional for both: if unset, ai-venue-mood returns 501 and its tile
# falls back to a plain tinted block; a "painting" gesture still sends
# with paintingStatus "failed" and an honest message instead of a
# fabricated image. No key is currently configured in this project as of
# when this file was written.
FAL_API_KEY=

# Tremendous (digital gift cards) and Goody (physical gift orders) were
# both evaluated and built for "curated"/"suggested" gestures, then
# deliberately abandoned 2026-08-28 per direct product decisions —
# Ittsui isn't using either. See docs/three-fronts-and-gestures.md.

# GIPHY — real GIF search for "message"-mode gestures
# (app/api/gestures/gif-search/route.ts). Verified 2026-08-28 against a
# real Beta API key created at developers.giphy.com/dashboard. The
# dashboard issues separate keys per app/platform — this route runs
# server-side (a Next.js API route), so it needs the Web key, not the
# Android one, even though both exist in the same GIPHY workspace.
# Optional: unset means the GIF picker just doesn't appear.
GIPHY_WEB_API_KEY=

# Stuart — real courier dispatch for "own"-mode gestures (once the
# recipient supplies their address — see lib/stuartCourier.ts and
# app/api/gestures/[gestureId]/route.ts's PATCH). Verified against
# Stuart's own open-source client libraries (github.com/StuartApp) on
# 2026-08-27, since their public docs portal doesn't republish the
# technical contract. Get credentials by creating a sandbox account at
# https://stuart.com/developers/ (API credentials appear at
# https://admin.sandbox.stuart.com/client/api once signed up):
#   STUART_CLIENT_ID
#   STUART_CLIENT_SECRET
#   STUART_ENV — "sandbox" (default, api.sandbox.stuart.com) or
#                "production" (api.stuart.com) — start with sandbox, and
#                note their sandbox requires a Stripe TEST card on file
#                before the first call succeeds (see their own
#                getting-started article).
# Same honest-fallback posture: unset means "own"-mode gestures behave
# exactly as before (no courier attempted).
STUART_CLIENT_ID=
STUART_CLIENT_SECRET=
STUART_ENV=sandbox

# Used directly again as of 2026-08-24 (lib/groq.ts) — NOT the same code
# path as before. It no longer influences venue selection (that's the RAG
# service's job, see RAG_SERVICE_URL above); it only rewrites the
# confirmation one-liner for tiers 2/3 of weekly-propose/route.ts's
# fallback chain into something warmer than the deterministic template.
# FALLBACK as of the same day Mistral was wired in below — Mistral tries
# first now (lib/confirmationText.ts). Optional either way: if this is
# unset too (or Mistral succeeds), Groq is simply never called for this;
# only if BOTH are unset/failing does the deterministic template text get
# used unchanged, exactly as before either of these existed.
GROQ_API_KEY=

# PRIMARY vendor as of 2026-08-24 for the confirmation-text rewrite
# (lib/confirmationText.ts) — real, direct tests showed faster, more
# idiomatic French from mistral-small-latest than Groq on the identical
# prompt. Falls back to GROQ_API_KEY (above) if this is unset, times out,
# errors, or the org's prepaid credit balance runs out — see
# lib/confirmationText.ts for the full chain. Paid, not free: this org's
# balance is a manually-topped-up prepaid credit (no monthly spend-limit
# toggle was found on this plan despite Mistral's public docs describing
# one) — the balance itself is the practical ceiling. Also required in
# whatever holds production env vars, not just here, before this ships.
MISTRAL_API_KEY=
