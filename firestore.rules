rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pairs: readable/writable only by the two linked users.
    // Client never creates a pair directly with arbitrary partner IDs beyond
    // themselves — partner resolution happens server-side via /api/find-user.
    match /pairs/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.userIds;

      match /weeks/{weekId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.userIds;
        // Writes to weeks only ever happen via server routes (Admin SDK
        // bypasses rules), so no client write path is allowed here.
        allow write: if false;
      }
    }

    // Venue shortlist is curated content — public read, no client writes
    match /venues/{venueId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Passkey (WebAuthn) credentials and their in-flight challenges —
    // server-only via Admin SDK (app/api/passkeys/**), same reasoning as
    // /pairs/{pairId}/weeks: the authentication ceremony's whole point is
    // verifying a cryptographic signature server-side, and the
    // authenticate flow specifically must look up a credential's public
    // key *before* anyone is signed in (that's what makes it a login, not
    // a re-auth) — there is no client-auth condition that could ever
    // safely permit direct client access here.
    match /passkeyCredentials/{credentialId} {
      allow read, write: if false;
    }
    match /passkeyChallenges/{challengeKey} {
      allow read, write: if false;
    }

    // Communities: N-member groups, distinct from a 2-person Pair, sharing
    // a single recurring slot any member may propose editing (day/time/
    // location/label). Membership itself does NOT change through this
    // same open update rule — it goes through a server route, same
    // reasoning /pairs already documents: resolving membership from
    // client-supplied ids directly would let anyone add/remove members by
    // guessing uids, whereas the server route can verify each addition the
    // same way partner resolution already works for pairs.
    match /communities/{communityId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;
    }

    // Contacts: a user's own address-book-style list (name + email), used
    // to pick a recipient when sending a MeetingRequest. Same ownership
    // rule as /users/{userId} — purely the owner's own data, nothing
    // cross-user to resolve server-side the way /pairs and /communities do.
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Meeting requests: one-off (not recurring, unlike /pairs and
    // /communities) rendezvous proposals sent to a contact by email. The
    // recipient has no known uid until they sign in — same "pending,
    // resolved server-side on accept" shape as /pairs' invite flow, via
    // /api/meeting-requests/respond (Admin SDK bypasses rules, same
    // reasoning /pairs and /communities already document above). No client
    // update path: accept/decline needs to verify the caller's email
    // against recipientEmail AND send the acceptance emails to both
    // parties, which only a server route can do — matching /pairs/weeks'
    // identical "no client write path" reasoning.
    match /meetingRequests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if false;
    }
  }
}
