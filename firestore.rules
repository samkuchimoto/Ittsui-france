rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own user doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pairs: readable/writable only by the two linked users.
    // Client never creates a pair directly with arbitrary partner IDs beyond
    // themselves — partner resolution happens server-side via /api/find-user.
    match /pairs/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.userIds;

      match /weeks/{weekId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.userIds;
        // Writes to weeks only ever happen via server routes (Admin SDK
        // bypasses rules), so no client write path is allowed here.
        allow write: if false;
      }
    }

    // Venue shortlist is curated content — public read, no client writes
    match /venues/{venueId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
