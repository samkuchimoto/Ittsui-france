# Copy to android/keystore.properties (gitignored, never commit the real file)
# and fill in real values to produce a locally signed release build.
#
# storeFile is resolved relative to android/app/build.gradle's working
# directory (android/app/), so either use an absolute path or a path
# starting with ../ if the .jks lives outside android/app/.
#
# For PKCS12 keystores (the modern keytool default), storePassword and
# keyPassword are always identical — keytool ignores a distinct -keypass.

storeFile=/absolute/path/to/ittsui-release.jks
storePassword=REPLACE_ME
keyAlias=ittsui
keyPassword=REPLACE_ME
